# MELANTIA — exclusiones de versionado
# Secretos / entorno local
.env
.env.*

# Entornos virtuales
.venv/
venv/

# Caché Python
__pycache__/
*.pyc

# Editores (config local, no canónica)
.cursor/
.vscode/

# Node / build frontend
node_modules/
dist/

# Datos masivos y binarios (datasets, modelos vosk)
datasets/
models/
cacao/
musaceas/
*.zip
*.xlsx
*.csv
*.mdl
*.fst

# Snapshots / dumps / extracciones legacy
melantia_old_version/
.legacy_extract/
backups/

# Credenciales temporales I0.1 (nunca versionar)
nueva_supabase.env

# PostgreSQL portable local (binarios + datos — regenerable)
.pg16/

# Supabase CLI — metadatos locales (project-ref, links)
supabase/.temp/

# Artefactos locales / herramientas — no versionar
*.exe
*.backup.gz
*.tar.gz
API OpenRouter/
