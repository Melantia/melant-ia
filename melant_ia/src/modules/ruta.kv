<RutaScreen@BoxLayout>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)

    Label:
        text: 'Calculadora de Expansión Nacional'
        font_size: dp(22)
        size_hint_y: None
        height: dp(40)

    GridLayout:
        cols: 2
        spacing: dp(8)
        size_hint_y: None
        height: dp(120)

        Label: text: 'Gastos de Viaje (transporte, hospedaje, comida):'
        TextInput: id: gastos_input; input_filter: 'float'; multiline: False

        Label: text: 'Costo de Envío (por paquetería):'
        TextInput: id: envio_input; input_filter: 'float'; multiline: False

        Label: text: 'Unidades a Vender:'
        TextInput: id: unidades_input; input_filter: 'int'; multiline: False

    Button:
        text: 'Calcular Ruta'
        size_hint_y: None
        height: dp(48)
        on_release: app.calcular_logistica()

    Label:
        id: resultado_label
        text: ''
        color: 1,1,0,1
        font_size: dp(16)
        size_hint_y: None
        height: dp(40)

    Button:
        text: 'Guardar Presupuesto de Viaje'
        size_hint_y: None
        height: dp(44)
        on_release: app.guardar_presupuesto()
