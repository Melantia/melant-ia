    "preguntas_frecuentes": {
      "titulo": "3.7 Preguntas Frecuentes - Nutrición Nativa",
      "q1": {
        "pregunta": "¿Compost casero es suficiente papa?",
        "respuesta": "SÍ típicamente (5-10 ton/hectárea + rotación abono verde). Rendimiento 12-15 ton/ha = balance nutrientes"
      },
      "q2": {
        "pregunta": "¿Biol funciona realmente?",
        "respuesta": "Funciona 50-70% eficacia urea. Beneficio: USD 0 costo (producción propia), sostenibilidad"
      },
      "q3": {
        "pregunta": "¿Haba como abono verde = ganancia doble?",
        "respuesta": "SÍ. Haba = cosecha venta USD 300-400/ton + nitrógeno gratuito = excelente sinergia"
      },
      "q4": {
        "pregunta": "¿Encalado es necesario papa nativa?",
        "respuesta": "SOLO si pH < 5.0 (muy ácido). Nativa tolera pH 5.0-6.5 mejor que convencional"
      },
      "q5": {
        "pregunta": "¿Sin fertilizante químico hay riesgo rendimiento?",
        "respuesta": "Riesgo bajo si compost + rotación. Esperar 10-15% menor rendimiento = tradeoff por sostenibilidad/costo"
      }
    ]
  }
