  "contenido": {
    "introduccion": {
      "titulo": "4.1 Introducción a Plagas de Arroz",
      "texto": "Arroz invitación plagas: ambiente acuático, monocultivo extenso, condiciones cálido-húmedas. Ecuador: 3-4 plagas principales = saltamontes (lepido monolea), barrenador tallo (chilo), mosquito del arroz (orseolia). Daño combinado puede alcanzar 40-50% rendimiento si descontrolado."
    },
    "saltamontes": {
      "titulo": "4.2 Saltamontes del Arroz (Lepidacis monolea)",
      "biologia": {
        "ciclo": "3 generaciones/año",
        "largo_vida": "Adulto 40-60 días",
        "reproduccion": "Hembra 50-150 huevos postura"
      },
      "sintomas": [
        "Esqueletizado hojas (comido solo parénquima, venas quedan)",
        "Daño máximo V4-V8 (plantas jóvenes sensibles)",
        "Presencia: saltamontes visibles día (búsqueda alimento)"
      ],
      "umbral_accion": "Muestreo: > 10 saltamontes/10 plantas = control",
      "control": [
        {
          "metodo": "Insecticida",
          "producto": "Permetrina 25 EC",
          "dosis": "0.5-0.75 L/hectárea",
          "costo": "USD 20-30"
        },
        {
          "metodo": "Alternativa biológica",
          "agente": "Hongos entomopatógenos (Beauveria, Metarhizium)",
          "costo": "USD 50-80"
        }
      ]
    },
    "barrenador": {
      "titulo": "4.3 Barrenador del Tallo (Chilo suppressalis)",
      "biologia": {
        "ciclo": "2-3 generaciones/año",
        "larva": "Penetra tallos, 3-4 semanas adentro",
        "sintoma": "Corazón blanco (tallo marchita post-floración)"
      },
      "daño": [
        "Larva consume vascular (nutrientes transporte cesará)",
        "Post-floración: panícula se seca = pérdida 30-50% grano"
      ],
      "monitoreo": [
        "Trampa luz (atrae adultos nocturnos)",
        "Revisión manual tallos (buscar perforaciones)"
      ],
      "umbral": "> 5 adultos/trampa luz/noche = control",
      "control": [
        {
          "metodo": "Insecticida",
          "producto": "Clorpirifós 50 EC",
          "dosis": "1-1.5 L/hectárea",
          "timing": "V8-VE (pre-emergencia panícula)"
        },
        {
          "metodo": "Rotación cultivos",
          "duracion": "Mínimo 2 años sin arroz (elimina pupas en rastrojos)"
        }
      ]
    },
    "mosquito_arroz": {
      "titulo": "4.4 Mosquito del Arroz (Orseolia oryzae)",
      "biologia": {
        "ciclo": "5-6 generaciones/año",
        "tamaño": "Micro (~1.5 mm)",
        "hospedero": "Huevos bajo vaina hoja"
      },
      "sintoma": "Pancita blanca (hijos/macollas blanquecinos, no crecen)",
      "epidemiologia": [
        "Sucede V4-V6 (macollejamiento crítico)",
        "Estrés sequía favorece (ablandamiento tejidos)"
      ],
      "control": [
        {
          "metodo": "Riego oportuno",
          "razon": "Mantiene inundación 5-10 cm = inhibe oviposición"
        },
        {
          "metodo": "Insecticida",
          "producto": "Imidacloprid 350 SC",
          "dosis": "20-30 mL/100 L agua",
          "costo": "USD 15-25"
        }
      ]
    },
