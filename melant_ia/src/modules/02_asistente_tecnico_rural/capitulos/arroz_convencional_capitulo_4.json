      "titulo": "4.6 Manejo Integrado de Plagas",
      "monitoreo": [
        "Semanal V3-V10 (máxima presión)",
        "Trapas luz (barrenador adultos)",
        "Búsqueda visual saltamontes"
      ],
      "umbral_economico": [
        "Saltamontes: > 10/10 plantas",
        "Barrenador: > 5 adultos/trampa",
        "Mosquito: > 30% plantas afectadas macollejamiento"
