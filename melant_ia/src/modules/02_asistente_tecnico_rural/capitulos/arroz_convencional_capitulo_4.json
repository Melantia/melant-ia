      "titulo": "4.5 Otras Plagas Secundarias",
      "garrampata": {
        "hospedero": "Huevo base hoja",
        "daño": "Leve (rara vez económicamente importante)"
      },
      "trips": {
        "daño": "Defoliación V2-V4, raro problema mayor"
      },
      "cochinilla": {
        "daño": "Succión savia, plantas enanismo si población densidad"
      }
