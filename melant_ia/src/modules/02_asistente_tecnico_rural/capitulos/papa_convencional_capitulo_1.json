    "ciclo_biologico": {
      "titulo": "1.4 Ciclo Biológico de Papa",
      "fases": [
        {
          "fase": "V0 (Siembra tubérculo)",
          "dias": "0 días",
          "proceso": "Tubérculo-semilla (25-30 g) contiene 2-4 ojos (yemas)"
        },
        {
          "fase": "V1-V3 (Emergencia)",
          "dias": "14-21 días",
          "proceso": "Brotes emergen, 2-3 tallos por yema",
          "temperatura": "Óptima 15-18°C"
        },
        {
          "fase": "V4-V8 (Crecimiento vegetativo)",
          "dias": "30-50 días",
          "proceso": "Expansión hojas, formación raíces, crecimiento tallo altura 20-30 cm"
        },
        {
          "fase": "V9-V12 (Tuberización)",
          "dias": "50-80 días",
          "proceso": "Iniciación stolones subterráneos → engrosamientos tubérculo",
          "factor": "Fotoperiodo corto (< 13 horas luz) gatilla tuberización"
        },
        {
          "fase": "V13-V15 (Llenado tubérculo)",
          "dias": "80-120 días",
          "proceso": "Acumulación almidón tuberoso, engrosamiento explosivo",
          "translocacion": "70-80% asimilados van tubérculo"
        },
        {
          "fase": "V16 (Madurez/Senescencia)",
          "dias": "120-150 días",
          "proceso": "Follaje amarilleo/muerte, tubérculo completamente maduro, cáscara endurecida",
          "cosecha": "LISTA cosecha"
        }
      ]
    },
    "estructuras_clave": {
      "titulo": "1.5 Estructuras Clave del Papa",
      "tubérculo": {
        "definicion": "Tallo subterráneo modificado (no es raíz), contiene almidón energía",
        "estructura": [
          "Cáscara (epidermis)",
          "Corteza (parénquima)",
          "Médula (centro, máximo almidón)"
        ],
        "ojos": "Yemas axilares distribuidas en espiral (genética variedad)"
      },
      "raices": {
        "caracteristica": "Fibrosas, someras (10-20 cm profundidad máxima)",
        "funcion": "Absorción agua/nutrientes (no producción tubérculo)"
      },
      "stolones": {
        "definicion": "Tallos subterráneos que engrosan extremo distal = tubérculo",
        "numero": "3-8 stolones por planta típico"
      }
    },
    "preguntas_frecuentes": {
      "titulo": "1.6 Preguntas Frecuentes - Botánica",
      "q1": {
        "pregunta": "¿Tubérculo es raíz?",
        "respuesta": "NO es tallo modificado (contiene venas, ojos). Raíces son fibrosas absorben agua. Confusión común agricultura."
      },
      "q2": {
        "pregunta": "¿Qué es fotoperiodo corto?",
        "respuesta": "Menos 13 horas luz/día = tuberización gatilla. Sierra ecuatoriana cerca línea ecuatorial = fotoperiodo estable, tuberización uniforme"
      },
      "q3": {
        "pregunta": "¿Variedad tetraploide rinde más?",
        "respuesta": "SÍ generalmente (Atlantic 35 ton/ha vs diploide nativa 10-15 ton/ha). PERO menos resistencia enfermedades locales"
      },
      "q4": {
        "pregunta": "¿Cuántos tallos por planta es normal?",
        "respuesta": "Típico 2-4 tallos (1-2 por ojo, según densidad siembra). Más tallos = competencia (rendimiento igual, tubérculos más pequeños)"
      },
      "q5": {
        "pregunta": "¿Papas verdes son tóxicas?",
        "respuesta": "SÍ. Exposición luz = solanina (alcaloide tóxico). Verde ≠ maduro. Almacenar oscuridad, rechazar tubérculos verdes consumo"
      }
    }
  }
}
