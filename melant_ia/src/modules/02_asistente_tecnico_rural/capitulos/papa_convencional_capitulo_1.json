      "genero": "Solanum",
      "especie": "S. tuberosum L.",
      "ploidy_niveles": [
        {
          "nivel": "Diploide (2n=24)",
          "caracteristica": "Variedades andinas nativas, menor rendimiento",
          "ejemplo": "Papa morada, Solantina"
        },
        {
          "nivel": "Triploide (3n=36)",
          "caracteristica": "Rara, esterilidad parcial"
        },
        {
          "nivel": "Tetraploide (4n=48)",
          "caracteristica": "Mayoría variedades mejoradas mundiales",
          "ejemplo": "Atlantic, Itabá, Fripapa"
        }
      ]
    },
