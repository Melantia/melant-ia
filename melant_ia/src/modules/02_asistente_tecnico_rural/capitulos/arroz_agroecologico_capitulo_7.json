    "preguntas_frecuentes": {
      "titulo": "7.7 Preguntas Frecuentes - Economía",
      "q1": {
        "pregunta": "¿Arroz agroecológico es más rentable?",
        "respuesta": "SÍ si: (1) certificación orgánica alcanzada (año 3+), (2) peces integrados (bonus 1,500-2,000/ha). Sin ambos = riesgo no viable"
      },
      "q2": {
        "pregunta": "¿Inversión inicial USD 1,360 es recuperable?",
        "respuesta": "SÍ en 2-3 años con peces. Payback = (USD 1,360 inversión) ÷ (USD 600-800 utilidad año = USD 1,700-2,200 = 1.6-2 años"
      },
      "q3": {
        "pregunta": "¿Peces garantizados vender?",
        "respuesta": "SÍ mercado local seguro (consumo proteína). Precio USD 3-4/kg = competitivo pollo USD 2-3/kg. Demanda > oferta"
      },
      "q4": {
        "pregunta": "¿Rendimiento arroz 3.5 ton es suficiente?",
        "respuesta": "Si precio + peces: SÍ. Grano solo: marginal vs convencional. Estrategia: visión total sistema (no solo grano)"
      },
      "q5": {
        "pregunta": "¿Certificación orgánica cuesta cuánto?",
        "respuesta": "USD 300-500/año organismo certificador. Inversión vale: +50-75% precio (USD 100-150 extra por tonelada = USD 245-367 / ha ingreso extra)"
