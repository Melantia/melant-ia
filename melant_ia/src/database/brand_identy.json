{    
  "app_name": "MELANT IA",
  "type": "adaptive_icon",
  "style": "minimalist_tech_rural",

  "canvas": {
    "shape": "square",
    "safe_area": "centered",
    "padding": "12%"
  },

  "background": {
    "type": "gradient",
    "colors": [
      "#0C1A0E",
      "#123E2A"
    ],
    "direction": "diagonal",
    "texture": "subtle_glow"
  },

  "foreground": {
    "composition": "leaf_circuit_fusion",

    "elements": [
      {
        "type": "leaf",
        "style": "geometric_simplified",
        "color": "#7CFC00",
        "stroke": "none",
        "position": "center",
        "scale": "0.75"
      },
      {
        "type": "circuit_lines",
        "style": "curved_clean",
        "color": "#A8FF60",
        "thickness": "medium",
        "connection_nodes": 3,
        "node_style": "rounded",
        "integration": "inside_leaf"
      },
      {
        "type": "outer_ring",
        "style": "partial_arc",
        "color": "#1F5F3A",
        "thickness": "thin",
        "opacity": "0.6",
        "position": "wrap_left"
      }
    ]
  },

  "lighting": {
    "type": "neon_accent",
    "intensity": "low",
    "color": "#9EFF00",
    "effect": "edge_glow"
  },

  "contrast": {
    "mode": "high_visibility",
    "foreground_vs_background": "strong"
  },

  "icon_rules": {
    "no_text": true,
    "no_small_details": true,
    "legibility_sizes": [
      "48px",
      "72px",
      "192px",
      "512px"
    ]
  },

  "brand_feeling": [
    "tecnología",
    "precisión",
    "campo",
    "confianza",
    "offline_ready"
  ],

  "platform_export": {
    "android": {
      "foreground": "transparent_png",
      "background": "solid_or_gradient",
      "adaptive": true
    },
    "ios": {
      "flattened": true,
      "no_transparency": true
    }
  }
}




