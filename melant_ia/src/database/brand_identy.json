{
  "project": {
    "name": "MELANT IA",
    "type": "Productividad Agricola Inteligente Offline",
    "category": "ASISTENTE TECNICO RURAL",
    "design_version": "Premium Neon Rural v3"
  },

  "brand_identity": {
    "main_message": "PRODUCTIVIDAD AGRICOLA INTELIGENTE OFFLINE",
    "secondary_message": "FUNCIONA SIN INTERNET",

    "brand_values": [
      "productividad",
      "precisión",
      "tecnología",
      "confianza",
      "campo",
      "offline_total"
    ],

    "target_users": [
      "Agricultores",
      "Ganaderos",
      "Ingenieros Agrónomos",
      "Técnicos rurales"
    ]
  },

  "canvas": {
    "shape": "rounded_square",
    "border_radius": "extreme_soft",
    "resolution": "2048x2048",

    "composition": {
      "layout": "vertical_centered",
      "focus_priority": [
        "logo_symbol",
        "brand_name",
        "primary_slogan",
        "offline_badge",
        "category"
      ]
    }
  },

  "background": {
    "type": "cinematic_dark_gradient",

    "colors": {
      "primary": "#020402",
      "secondary": "#0C1A0E",
      "accent": "#123E2A"
    },

    "effects": {
      "vignette": true,
      "soft_fog": true,
      "neon_edge_glow": {
        "enabled": true,
        "color": "#9EFF00",
        "opacity": 0.35,
        "blur": 25
      }
    },

    "environment": {
      "scene": "rural_field_night",
      "visibility": "subtle",
      "purpose": "give_agricultural_context_without_distraction"
    }
  },

  "main_symbol": {
    "type": "leaf_circuit_hybrid",

    "meaning": {
      "leaf": "Agricultura y sostenibilidad",
      "circuits": "IA y precisión digital",
      "outer_arc": "protección y autonomía offline",
      "nodes": "conectividad inteligente rural"
    },

    "structure": {
      "center_alignment": true,
      "scale": "0.42_canvas",

      "elements": [
        {
          "type": "organic_leaf",
          "style": "semi_realistic",
          "color_gradient": [
            "#7CFC00",
            "#4CAF50",
            "#2E7D32"
          ],

          "details": {
            "main_vein": true,
            "side_veins": "minimal",
            "gloss": "soft"
          }
        },

        {
          "type": "digital_circuit",

          "style": {
            "line_type": "clean_curved",
            "thickness": "medium",
            "caps": "rounded"
          },

          "colors": {
            "main": "#FFFFFF",
            "glow": "#9EFF00"
          },

          "nodes": {
            "count": 4,
            "shape": "circular",
            "lighting": "neon_soft"
          }
        },

        {
          "type": "protective_arc",

          "position": "left_and_right_wrap",

          "style": {
            "stroke_width": "medium",
            "opacity": 0.95
          },

          "color": "#B7FF00"
        }
      ]
    }
  },

  "typography": {
    "brand_name": {
      "text": "MELANT IA",

      "font_style": {
        "family": "Montserrat ExtraBold",
        "case": "uppercase",
        "spacing": "wide"
      },

      "colors": {
        "MELANT": "#F5F5F5",
        "IA": "#B7FF00"
      },

      "effects": {
        "soft_glow": true,
        "shadow_depth": "low"
      }
    },

    "primary_slogan": {
      "text": "PRODUCTIVIDAD AGRICOLA INTELIGENTE OFFLINE",

      "style": {
        "family": "Poppins SemiBold",
        "size": "small",
        "tracking": "medium"
      },

      "color_logic": {
        "normal_text": "#FFFFFF",
        "highlight_text": "#B7FF00"
      }
    },

    "secondary_slogan": {
      "text": "FUNCIONA SIN INTERNET",

      "container": {
        "type": "capsule_badge",
        "background": "#071109",
        "border": "#9EFF00",
        "radius": "pill"
      },

      "icon": {
        "type": "offline_signal",
        "color": "#FFFFFF"
      }
    },

    "category_block": {
      "title": "CATEGORIA:",
      "value": "ASISTENTE TECNICO RURAL",

      "layout": {
        "icon_left": true,
        "alignment": "horizontal"
      },

      "icon": {
        "type": "farmer_outline",
        "accent_leaf": true,
        "color": "#9EFF00"
      }
    }
  },

  "lighting_system": {
    "mode": "premium_neon",

    "light_sources": [
      {
        "position": "top_edges",
        "color": "#9EFF00",
        "intensity": "medium"
      },
      {
        "position": "logo_nodes",
        "color": "#FFFFFF",
        "intensity": "high"
      }
    ],

    "shadow_system": {
      "soft_depth": true,
      "background_separation": true
    }
  },

  "mobile_visibility": {
    "optimized_for": [
      "Android",
      "PWA",
      "APK",
      "Launcher Icon",
      "Splash Screen"
    ],

    "visibility_rules": [
      "high_contrast",
      "large_shapes",
      "minimum_micro_details",
      "strong_center_focus"
    ]
  },

  "ui_feeling": {
    "experience": [
      "premium",
      "tecnología avanzada",
      "potencia offline",
      "precisión agrícola",
      "fácil de usar"
    ],

    "visual_reference": [
      "Tesla UI",
      "NVIDIA neon aesthetics",
      "AgroTech modern systems"
    ]
  }
}



